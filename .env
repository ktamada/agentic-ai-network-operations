OPENAI_API_KEY=<YOUR-OPEN-API-KEY>
OPENAI_MODEL=gpt-5.6
DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5432/agentic_ai
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INCIDENT_TOPIC=customer.incidents.inbound
KAFKA_COMPLETED_TOPIC=agent.incidents.completed
KAFKA_CHANGE_TOPIC=network.change.events
KAFKA_CONSUMER_GROUP=agentic-ai-orchestrator
ENABLE_KAFKA_CONSUMER=false
PROMETHEUS_URL=http://127.0.0.1:9090
NETWORK_TELEMETRY_SOURCE=prometheus
OPENAI_AGENTS_DISABLE_TRACING=0
